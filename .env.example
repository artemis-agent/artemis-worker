ARTEMIS_DATABASE_URL=postgresql+asyncpg://artemis:artemis@localhost:5432/artemis
ARTEMIS_DATABASE_URL_SYNC=postgresql://artemis:artemis@localhost:5432/artemis
ARTEMIS_REDIS_URL=redis://localhost:6379/0

# Primary Azure OpenAI deployment
ARTEMIS_AZURE_OPENAI_API_KEY=
ARTEMIS_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
ARTEMIS_AZURE_OPENAI_API_VERSION=2024-10-21

# Optional secondary deployment (different region) for rate-limit failover.
# When both are set, requests round-robin between them and automatically
# fail over to the other when one hits a 429.
ARTEMIS_AZURE_OPENAI_API_KEY_2=
ARTEMIS_AZURE_OPENAI_ENDPOINT_2=https://your-resource-2.openai.azure.com

ARTEMIS_LLM_MODEL=gpt-4.1
ARTEMIS_EMBEDDING_MODEL=text-embedding-3-small

ARTEMIS_CRUNCHBASE_API_KEY=
ARTEMIS_GITHUB_TOKEN=
ARTEMIS_GITHUB_REPO=
